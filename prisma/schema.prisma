// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DB_URL")
}

model User {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  email_address     String   @unique
  first_name  String
  last_name String
  password_hash String
  followedBy Follows[]  @relation("follower")
  following  Follows[]  @relation("following")
  purchasedItems WishListItem[] @relation("purchasedItems")
  requestedItems WishListItem[] @relation("requestedItems")
}

model Follows {
  follower    User @relation("follower", fields: [followerId], references: [id])
  followerId  String
  following   User @relation("following", fields: [followingId], references: [id])
  followingId String

  @@id([followerId, followingId])
}

model WishListItem {
  id    String @id @default(uuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  name  String
  url   String?
  requestingUser User @relation("requestedItems", fields: [requestingUserId], references: [id])
  requestingUserId String
  purchasedByUser User? @relation("purchasedItems", fields: [purchasedById], references: [id])
  purchasedById String?
}